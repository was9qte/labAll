CREATE TABLE Удаленные_посетители (
    Id INT,
    Phone CHAR(10),
    Name VARCHAR(50),
    DateBirth DATETIME,
    Email VARCHAR(50),
    дата_удаления DATETIME,
    логин VARCHAR(100)
);







CREATE DEFINER = CURRENT_USER TRIGGER `ispp5503`.`Visitor_AFTER_DELETE` 
AFTER DELETE ON `Visitor` FOR EACH ROW
BEGIN
    INSERT INTO Удаленные_посетители (Id, Phone, Name, DateBirth, Email, дата_удаления, логин)
    VALUES (OLD.Id, OLD.Phone, OLD.Name, OLD.DateBirth, OLD.Email, NOW(), USER());
END







