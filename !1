
CREATE TABLE Журнал_изменений_Email (
    код_посетителя INT,
    старый_Email VARCHAR(50),
    новый_Email VARCHAR(50),
    дата_изменения DATETIME
);






DELIMITER //
CREATE TRIGGER Visitor_AFTER_UPDATE
AFTER UPDATE ON Visitor
FOR EACH ROW
BEGIN
    -- Строго по заданию используем NULL-безопасный оператор <=>
    IF NOT (OLD.Email <=> NEW.Email) THEN
        INSERT INTO Журнал_изменений_Email (код_посетителя, старый_Email, новый_Email, дата_изменения)
        VALUES (OLD.Id, OLD.Email, NEW.Email, NOW());
    END IF;
END //
DELIMITER ;







CREATE TABLE Удаленные_посетители (
    Id INT,
    Phone CHAR(10),
    Name VARCHAR(50),
    DateBirth DATETIME,
    Email VARCHAR(50),
    дата_удаления DATETIME,
    логин VARCHAR(100)
);







CREATE DEFINER = CURRENT_USER TRIGGER `ispp5503`.`Visitor_AFTER_DELETE` 
AFTER DELETE ON `Visitor` FOR EACH ROW
BEGIN
    INSERT INTO Удаленные_посетители (Id, Phone, Name, DateBirth, Email, дата_удаления, логин)
    VALUES (OLD.Id, OLD.Phone, OLD.Name, OLD.DateBirth, OLD.Email, NOW(), USER());
END







DELIMITER //
CREATE TRIGGER Film_BEFORE_DELETE
BEFORE DELETE ON Film
FOR EACH ROW
BEGIN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Требуется выполнить UPDATE для столбца is_deleted';
END //
DELIMITER ;




