string GetSize(long bytes)
{
    if (bytes < 1024)
        return $"{bytes} Б";
    if (bytes < (1L << 20))
        return $"{bytes >> 10} КБ";
    if (bytes < (1L << 30))
        return $"{bytes >> 20} МБ";

    return $"{bytes >> 30} ГБ";
}





public void FindSum(int[] numbers)
{
    if (numbers.Length == 0)
        throw new InvalidOperationException("в массиве нет чисел");

    int sum = 0;
    for (int i = 0; i < numbers.Length; i++)
    {
        sum += numbers[i];
    }

    Console.WriteLine($"sum = {sum}");
}
