<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписка" Height="250" Width="350">
    <StackPanel Margin="10">

        <TextBlock Text="Логин:"/>
        <TextBox Name="LoginBox" Margin="0,5,0,10"/>

        <TextBlock Text="Email:"/>
        <TextBox Name="EmailBox" Margin="0,5,0,10"/>

        <CheckBox Name="AgreeCheckBox"
                  Content="Я согласен на получение рассылки"
                  Checked="AgreeCheckBox_Checked"
                  Unchecked="AgreeCheckBox_Checked"
                  Margin="0,10"/>

        <Button Name="SubscribeButton"
                Content="Подписаться"
                IsEnabled="False"
                Height="30"/>
    </StackPanel>
</Window>
