
private void CopyPassword_Click(object sender, RoutedEventArgs e)

        {

            Button button = sender as Button;

            string password = button.Tag.ToString();

            Clipboard.SetText(password);

            MessageBox.Show("Пароль скопирован!");

        }

    }

}








<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataGrid" Height="450" Width="900">

    <Grid>

        <DataGrid Name="dgUsers"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AlternatingRowBackground="LightGray"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <!-- Адрес -->
                <DataGridHyperlinkColumn Header="Адрес"
                                         Binding="{Binding Address}"
                                         Width="*" />

                <!-- Логин -->
                <DataGridTextColumn Header="Логин"
                                    Binding="{Binding Login}"
                                    Width="*" />

                <!-- Скрытый пароль -->
                <DataGridTextColumn Header="Пароль"
                                    Binding="{Binding HiddenPassword}"
                                    IsReadOnly="True"
                                    Width="*" />

                <!-- Архив -->
                <DataGridCheckBoxColumn Header="Архивный"
                                        Binding="{Binding IsArchived}"
                                        Width="*" />

                <!-- Кнопка -->
                <DataGridTemplateColumn Header="Действие" Width="150">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="Скопировать пароль"
                                    Click="CopyPassword_Click"
                                    Tag="{Binding Password}" />

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>








