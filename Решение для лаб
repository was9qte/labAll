<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="Главное окно"
        Height="450"
        Width="700">

    <Window.Resources>

        <Style x:Key="MyRadioStyle" TargetType="RadioButton">

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="br"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="5"
                                Padding="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="br"
                                        Property="Background"
                                        Value="Blue"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="br"
                                        Property="Background"
                                        Value="Gray"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <StackPanel>

        <!-- Меню -->
        <RadioButton Content="Пункт 1"
                     Background="LightBlue"
                     Style="{StaticResource MyRadioStyle}"
                     Checked="RadioButton_Checked"/>

        <RadioButton Content="Пункт 2"
                     Background="LightBlue"
                     Style="{StaticResource MyRadioStyle}"
                     Checked="RadioButton_Checked"/>

        <RadioButton Content="Пункт 3"
                     Background="LightBlue"
                     Style="{StaticResource MyRadioStyle}"
                     Checked="RadioButton_Checked"/>

        <RadioButton Content="Пункт 4"
                     Background="LightBlue"
                     Style="{StaticResource MyRadioStyle}"
                     Checked="RadioButton_Checked"/>

        <RadioButton Content="Пункт 5"
                     Background="LightBlue"
                     Style="{StaticResource MyRadioStyle}"
                     Checked="RadioButton_Checked"/>

        <!-- Часы -->
        <local:ClockControl Margin="10"/>

        <!-- Счётчик -->
        <local:CounterControl x:Name="counter"
                              ValueChanged="counter_ValueChanged"/>

        <TextBlock x:Name="txt"
                   FontSize="20"
                   Margin="10"/>

    </StackPanel>

</Window>






using System.Windows;
using System.Windows.Controls;

namespace WpfApp1
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();

            counter.MaxValue = 5;
        }

        private void RadioButton_Checked(object sender, RoutedEventArgs e)
        {
            RadioButton rb = sender as RadioButton;

            Title = rb.Content.ToString();
        }

        private void counter_ValueChanged(object sender, RoutedEventArgs e)
        {
            txt.Text = "Количество: " + counter.Value;
        }
    }
}






