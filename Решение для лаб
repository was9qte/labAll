using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

namespace FileFilterApp;

public partial class FilesPage : ContentPage
{
    private List<FileItem> allFiles = new();

    public FilesPage()
    {
        InitializeComponent();

        LoadFiles(@"C:\Test");
    }

    // =========================================================
    // ЗАГРУЗКА ФАЙЛОВ
    // =========================================================

    private void LoadFiles(string path)
    {
        DirectoryInfo directory = new DirectoryInfo(path);

        allFiles = directory.GetFiles()
            .Select(f => new FileItem
            {
                Name = f.Name,
                Extension = f.Extension,
                FullPath = f.FullName,
                Size = f.Length,
                Created = f.CreationTime,
                Modified = f.LastWriteTime
            })
            .ToList();

        FilesListView.ItemsSource = allFiles;

        CountLabel.Text =
            $"Показано {allFiles.Count} из {allFiles.Count} записей";
    }

    // =========================================================
    // 3.1 ФИЛЬТРАЦИЯ ПО ИМЕНИ ФАЙЛА
    // =========================================================

    private void SearchEntry_TextChanged(object sender,
        TextChangedEventArgs e)
    {
        string text = SearchEntry.Text?.ToLower() ?? "";

        var result = allFiles
            .Where(f => f.Name.ToLower().Contains(text))
            .ToList();

        FilesListView.ItemsSource = result;

        CountLabel.Text =
            $"Показано {result.Count} из {allFiles.Count} записей";
    }

    // =========================================================
    // СБРОС ФИЛЬТРА
    // =========================================================

    private void ResetButton_Clicked(object sender, EventArgs e)
    {
        SearchEntry.Text = "";

        FilesListView.ItemsSource = allFiles;

        CountLabel.Text =
            $"Показано {allFiles.Count} из {allFiles.Count} записей";
    }

    // =========================================================
    // 3.2 ФИЛЬТРАЦИЯ С RadioButton
    // =========================================================

    private async void SizeFilter_Changed(object sender, EventArgs e)
    {
        long size = 0;

        long.TryParse(SizeEntry.Text, out size);

        IEnumerable<FileItem> result = allFiles;

        if (GreaterRadio.IsChecked)
        {
            result = result.Where(f => f.Size >= size);
        }
        else if (LessRadio.IsChecked)
        {
            result = result.Where(f => f.Size <= size);
        }

        var list = result.ToList();

        FilesListView.ItemsSource = list;

        CountLabel.Text =
            $"Показано {list.Count} из {allFiles.Count} записей";

        if (!list.Any())
        {
            await DisplayAlert(
                "Информация",
                "Подходящих файлов не найдено",
                "OK");
        }
    }

    // =========================================================
    // 3.3 ФИЛЬТРАЦИЯ ПО НЕСКОЛЬКИМ УСЛОВИЯМ
    // =========================================================

    private async void MultiFilter_Changed(object sender, EventArgs e)
    {
        IEnumerable<FileItem> result = allFiles;

        // Минимальный размер

        if (MinCheckBox.IsChecked)
        {
            long min = 0;

            long.TryParse(MinEntry.Text, out min);

            result = result.Where(f => f.Size >= min);
        }

        // Максимальный размер

        if (MaxCheckBox.IsChecked)
        {
            long max = 0;

            long.TryParse(MaxEntry.Text, out max);

            result = result.Where(f => f.Size <= max);
        }

        var list = result.ToList();

        FilesListView.ItemsSource = list;

        CountLabel.Text =
            $"Показано {list.Count} из {allFiles.Count} записей";

        if (!list.Any())
        {
            await DisplayAlert(
                "Информация",
                "Файлы не найдены",
                "OK");
        }
    }
}


















