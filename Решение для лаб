
<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файлы" Height="450" Width="800">

    <Grid>
        <ListView Name="lvFiles" Margin="10">
            <ListView.View>
                <GridView>

                    <GridViewColumn Header="Имя файла"
                                    Width="250"
                                    DisplayMemberBinding="{Binding Name}" />

                    <GridViewColumn Header="Дата изменения"
                                    Width="180"
                                    DisplayMemberBinding="{Binding LastWriteTime}" />

                    <GridViewColumn Header="Расширение"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Extension}" />

                    <GridViewColumn Header="Размер"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Length}" />

                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>










using System.Collections.Generic;
using System.IO;
using System.Windows;

namespace WpfApp1
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();

            // Получаем список файлов из папки Documents
            DirectoryInfo directory = new DirectoryInfo(@"C:\Users\Public\Documents");

            List<FileInfo> files = new List<FileInfo>(directory.GetFiles());

            // Устанавливаем источник данных
            lvFiles.ItemsSource = files;
        }
    }
}
