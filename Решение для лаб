
<Style TargetType="Button">
    
    <!-- Обычный цвет кнопки -->
    <Setter Property="Background" Value="LightGray"/>

    <Style.Triggers>

        <!-- При наведении мыши -->
        <Trigger Property="IsMouseOver" Value="True">

            <!-- Смена фона -->
            <Setter Property="Background" Value="Blue"/>

        </Trigger>

    </Style.Triggers>
</Style>






