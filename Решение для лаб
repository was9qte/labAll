namespace LabWork35
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
        }

        // твои OpenButton_Click и SaveButton_Click

        protected override void OnClosing(CancelEventArgs e)
        {
            MessageBoxResult result = MessageBox.Show(
                "Вы хотите закрыть приложение?",
                "Подтверждение",
                MessageBoxButton.YesNo,
                MessageBoxImage.Question);

            if (result != MessageBoxResult.Yes)
            {
                e.Cancel = true;
            }

            base.OnClosing(e);
        }
    }
}





private void Window_KeyDown(object sender, KeyEventArgs e)
{
    if (Keyboard.Modifiers == ModifierKeys.Control && e.Key == Key.S)
    {
        Save_Click(null, null);
    }

    if (Keyboard.Modifiers == ModifierKeys.Control && e.Key == Key.N)
    {
        Create_Click(null, null);
    }

    if (Keyboard.Modifiers == ModifierKeys.Control && e.Key == Key.O)
    {
        Open_Click(null, null);
    }
}






<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор"
        Height="450"
        Width="800">

    <DockPanel>

        <!-- МЕНЮ -->
        <Menu DockPanel.Dock="Top">

            <!-- ФАЙЛ -->
            <MenuItem Header="Файл">

                <MenuItem Header="Создать"
                          Click="Create_Click"
                          InputGestureText="Ctrl+N"/>

                <MenuItem Header="Открыть"
                          Click="Open_Click"
                          InputGestureText="Ctrl+O"/>

                <MenuItem Header="Сохранить"
                          Click="Save_Click"
                          InputGestureText="Ctrl+S"/>

                <Separator/>

                <MenuItem Header="Выход"
                          Click="Exit_Click"/>

            </MenuItem>

            <!-- ВИД -->
            <MenuItem Header="Вид">

                <MenuItem x:Name="statusMenu"
                          Header="Строка состояния"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="statusMenu_Click"/>

            </MenuItem>

            <!-- СПРАВКА -->
            <MenuItem Header="Справка">

                <MenuItem Header="О программе"
                          Click="About_Click"/>

            </MenuItem>

        </Menu>

        <!-- СТРОКА СОСТОЯНИЯ -->
        <StatusBar x:Name="statusBar"
                   DockPanel.Dock="Bottom">

            <TextBlock Text="Готово"/>

        </StatusBar>

        <!-- ТЕКСТ -->
        <TextBox x:Name="txtBox"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

    </DockPanel>
</Window>








using Microsoft.Win32;
using System.IO;
using System.Windows;

namespace WpfApp1
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
        }

        // СОЗДАТЬ
        private void Create_Click(object sender, RoutedEventArgs e)
        {
            txtBox.Clear();
        }

        // ОТКРЫТЬ
        private void Open_Click(object sender, RoutedEventArgs e)
        {
            OpenFileDialog open = new OpenFileDialog();

            if (open.ShowDialog() == true)
            {
                txtBox.Text = File.ReadAllText(open.FileName);
            }
        }

        // СОХРАНИТЬ
        private void Save_Click(object sender, RoutedEventArgs e)
        {
            SaveFileDialog save = new SaveFileDialog();

            if (save.ShowDialog() == true)
            {
                File.WriteAllText(save.FileName, txtBox.Text);
            }
        }

        // ВЫХОД
        private void Exit_Click(object sender, RoutedEventArgs e)
        {
            Close();
        }

        // СТРОКА СОСТОЯНИЯ
        private void statusMenu_Click(object sender, RoutedEventArgs e)
        {
            if (statusMenu.IsChecked)
                statusBar.Visibility = Visibility.Visible;
            else
                statusBar.Visibility = Visibility.Hidden;
        }

        // СПРАВКА
        private void About_Click(object sender, RoutedEventArgs e)
        {
            MessageBox.Show("Текстовый редактор");
        }
    }
}

