   private void FontSize_Checked(object sender, RoutedEventArgs e)

        {

            RadioButton rb = sender as RadioButton;

            if (rb != null)

            {

                // получаем число из Content

                double size = double.Parse(rb.Content.ToString());

                // применяем к TextBox

                InputTextBox.FontSize = size;

            }

        }

    }

}
