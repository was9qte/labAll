public partial class MainPage : ContentPage

{

    private List<string> allFiles = new();

    private List<string> filteredFiles = new();

    private int currentPage = 1;

    private int pageSize = 5;

    public MainPage()

    {

        InitializeComponent();

        GenerateFiles();

        PageSizePicker.SelectedIndex = 0;

        filteredFiles = allFiles;

        LoadPage();

    }

    // Создание тестовых данных

    private void GenerateFiles()

    {

        for (int i = 1; i <= 50; i++)

        {

            allFiles.Add($"Файл_{i}.txt");

        }

    }

    // Загрузка страницы

    private void LoadPage()

    {

        var items = filteredFiles

            .Skip((currentPage - 1) * pageSize)

            .Take(pageSize)

            .ToList();

        FilesCollection.ItemsSource = items;

        int totalPages =

            (int)Math.Ceiling((double)filteredFiles.Count / pageSize);

        PageLabel.Text = $"Страница {currentPage} из {totalPages}";

    }

    // Следующая страница

    private void NextButton_Clicked(object sender, EventArgs e)

    {

        int totalPages =

            (int)Math.Ceiling((double)filteredFiles.Count / pageSize);

        if (currentPage < totalPages)

        {

            currentPage++;

            LoadPage();

        }

    }

    // Предыдущая страница

    private void PrevButton_Clicked(object sender, EventArgs e)

    {

        if (currentPage > 1)

        {

            currentPage--;

            LoadPage();

        }

    }

    // Переход к странице

    private void GoToPageButton_Clicked(object sender, EventArgs e)

    {

        if (int.TryParse(PageEntry.Text, out int page))

        {

            int totalPages =

                (int)Math.Ceiling((double)filteredFiles.Count / pageSize);

            if (page >= 1 && page <= totalPages)

            {

                currentPage = page;

                LoadPage();

            }

        }

    }

    // Фильтрация

    private void FilterEntry_TextChanged(object sender, TextChangedEventArgs e)

    {

        string filter = FilterEntry.Text?.ToLower() ?? "";

        filteredFiles = allFiles

            .Where(x => x.ToLower().Contains(filter))

            .ToList();

        currentPage = 1;

        LoadPage();

    }

    // Изменение размера страницы

    private void PageSizePicker_SelectedIndexChanged(object sender, EventArgs e)

    {

        if (int.TryParse(PageSizePicker.SelectedItem?.ToString(), out int size))

        {

            pageSize = size;

            currentPage = 1;

            LoadPage();

        }

    }

}












